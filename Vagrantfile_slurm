# -*- mode: ruby -*-
# vi: set ft=ruby :

# Check that required vagrant plugins are installed
["vagrant-hosts", "vagrant-libvirt"].each do |plugin|
  abort "Please install the #{plugin} Vagrant plugin with 'vagrant pluging install #{plugin}'" unless Vagrant.has_plugin?("#{plugin}")
end

SUBNET = "192.168.128"
DOMAIN = "vm.local"

MASTERNAME = "puppetmaster"
MASTERIP = "#{SUBNET}.2"

SLURMCTRLNAME = "slurmctrl"
SLURMCTRLIP = "#{SUBNET}.3"

SLURMLOGINNAME = "slurmlogin"
SLURMLOGINIP = "#{SUBNET}.4"

SLURMNODENAMEPREFIX = "slurmnode"

SLURMNBNODES = 1


Vagrant.configure "2" do |config|

  config.vm.provider :libvirt do |libvirt|
    libvirt.qemu_use_session = false
    libvirt.memory = 1024
    libvirt.cpus = 1
  end

  config.vm.define :puppetmaster do |pm|
    pm.vm.box = "eurolinux-vagrant/rocky-8"
    pm.vm.box_version = "8.10.5"
    pm.vm.hostname = "#{MASTERNAME}.#{DOMAIN}"
    pm.vm.network :private_network, ip: "#{MASTERIP}" 
    dir = File.expand_path("..", __FILE__)
    puts "DIR: #{dir}"
    pm.vm.provision :shell, :path => File.join(dir, "vagrant_pm_install.sh")
    pm.vm.provision :hosts, :sync_hosts => true
  end

  config.vm.define :slurmcontroller do |sctrl|
    sctrl.vm.box = "eurolinux-vagrant/rocky-9"
    sctrl.vm.box_version = "9.4.5"
    sctrl.vm.hostname = "#{SLURMCTRLNAME}.#{DOMAIN}"
    sctrl.vm.network :private_network, ip: "#{SLURMCTRLIP}" 
    dir = File.expand_path("..", __FILE__)
    puts "DIR: #{dir}"
    sctrl.vm.provision :shell do |s|
      s.path = File.join(dir,"vagrant_client_install.sh")
      s.args = "#{MASTERNAME}.#{DOMAIN} slurm controller production"
    end
    sctrl.vm.provision :hosts, :sync_hosts => true
  end

  config.vm.define :slurmlogin do |slogin|
    slogin.vm.box = "eurolinux-vagrant/rocky-9"
    slogin.vm.box_version = "9.4.5"
    slogin.vm.hostname = "#{SLURMLOGINNAME}.#{DOMAIN}"
    slogin.vm.network :private_network, ip: "#{SLURMLOGINIP}" 
    dir = File.expand_path("..", __FILE__)
    puts "DIR: #{dir}"
    slogin.vm.provision :shell do |s|
      s.path = File.join(dir,"vagrant_client_install.sh")
      s.args = "#{MASTERNAME}.#{DOMAIN} slurm login production"
    end
    slogin.vm.provider :libvirt do |libvirt|
      libvirt.memory = 2048
      libvirt.cpus = 2
    end
    slogin.vm.provision :hosts, :sync_hosts => true
  end

  SLURMNBNODES.times do |index|
    config.vm.define "#{SLURMNODENAMEPREFIX}#{index}".to_sym do |node|
        node.vm.box = "eurolinux-vagrant/rocky-9"
        node.vm.box_version = "9.4.5"
        node.vm.hostname = "#{SLURMNODENAMEPREFIX}#{index}.#{DOMAIN}"
        node.vm.network :private_network, ip: "#{SUBNET}.#{index+10}"
        dir = File.expand_path("..", __FILE__)
        puts "DIR: #{dir}"
        node.vm.provision :shell do |s|
          s.path = File.join(dir,"vagrant_client_install.sh")
          s.args = "#{MASTERNAME}.#{DOMAIN} slurm node production"
        end
        node.vm.provision :hosts, :sync_hosts => true
    end
  end  

end